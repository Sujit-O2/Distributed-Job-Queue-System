# PulseQueue Environment Configuration
# Copy to .env and modify for your environment

# ── Database ────────────────────────────────────────────────
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=jobqueue
POSTGRES_PORT=5433
# DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5433/jobqueue

# ── API Server ──────────────────────────────────────────────
APP_PORT=8000
WEB_CONCURRENCY=2
GUNICORN_TIMEOUT=120
GUNICORN_GRACEFUL_TIMEOUT=30
GUNICORN_KEEPALIVE=5

# ── JWT Security (#45, #47) ─────────────────────────────────
JWT_SECRET_KEY=change_me_in_production_use_64_char_hex
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=1440

# ── Worker Configuration ────────────────────────────────────
WORKER_POLL_INTERVAL=5
WORKER_TASK_TIMEOUT=600
WORKER_MAX_RETRIES=3
WORKER_MAX_TASKS=1000
WORKER_HEARTBEAT_INTERVAL=30
WORKER_NAME=Worker-1

# ── Docker Compose ──────────────────────────────────────────
COMPOSE_NETWORK_NAME=jobqueue_network

# ── PaddleOCR ───────────────────────────────────────────────
PADDLE_PDX_DISABLE_MODEL_SOURCE_CHECK=True
